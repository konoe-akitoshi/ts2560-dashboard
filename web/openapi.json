    "/api/v1/events": {
      "get": {
        "summary": "収集が終わるたびに status を送る（Server-Sent Events）",
        "tags": [
          "stream"
        ],
        "description": "接続直後にいまの状態を1回送り、その後は収集のたびに `event: status` で /api/v1/status と同じ JSON を送る。`id` は収集の通し番号。25秒ごとにコメント行（`: ping`）を送る。",
        "responses": {
          "200": {
            "description": "イベントの流れ",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "retry: 10000\nid: 42\nevent: status\ndata: {\"ok\":true,...}\n\n"
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus のメトリクス",
        "tags": [
          "monitoring"
        ],
        "responses": {
          "200": {
            "description": "テキスト形式 0.0.4",
            "content": {
              "text/plain; version=0.0.4": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "生きているか（liveness）。/livez も同じ",
        "tags": [
          "monitoring"
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "1回でも収集が終わったか（readiness）",
        "tags": [
          "monitoring"
        ],
        "responses": {
          "200": {
            "description": "ok"
          },
          "503": {
            "description": "まだ"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "この仕様",
        "tags": [
