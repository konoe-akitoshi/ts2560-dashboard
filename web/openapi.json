{
  "openapi": "3.1.0",
  "info": {
    "title": "ts2560-dashboard API",
    "version": "1.0.0",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "description": "セイコー TS-2560 の状態を、ダッシュボードが集めた結果から返す読み取り専用の API。機器には interval 秒ごとに1回だけアクセスし、API はその結果を返す（API を何度呼んでも機器の負荷は増えない）。非公式。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "status",
      "description": "最後の収集結果"
    },
    {
      "name": "stream",
      "description": "更新の通知"
    },
    {
      "name": "monitoring",
      "description": "監視・プローブ"
    },
    {
      "name": "meta"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "summary": "収集結果のすべて",
        "tags": [
          "status"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Last-Modified": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match と同じ内容"
          }
        },
        "description": "画面が使っているのと同じ JSON。/api/status も同じ（互換のため）。"
      }
    },
    "/api/v1/ntp": {
      "get": {
        "summary": "NTP：ntpd の状態、ピア、このサーバーからの測定",
