                  "$ref": "#/components/schemas/NTP"
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match と同じ内容"
          },
          "503": {
            "description": "まだ機器から読めていない",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
