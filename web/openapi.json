        ],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NTPProbe": {
        "type": "object",
        "properties": {
          "stratum": {
            "type": "integer"
          },
          "leap": {
            "type": "integer",
            "description": "3 = 非同期"
          },
          "refid": {
            "type": "string"
          },
          "offset": {
            "type": "number",
            "description": "このサーバーの時計との差（秒）"
          },
          "rtt": {
            "type": "number",
            "description": "往復時間（秒）"
          }
        }
      },
      "NTPState": {
        "type": "object",
        "properties": {
          "system_peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "stratum": {
            "type": [
              "integer",
              "null"
            ]
          },
          "refid": {
            "type": "string"
          },
          "root_dispersion": {
            "type": [
              "number",
              "null"
            ]
          },
          "jitter": {
            "type": [
              "number",
              "null"
            ]
          },
          "leap": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Peer": {
        "type": "object",
        "properties": {
          "tally": {
            "type": "string",
            "enum": [
              "selected",
              "candidate",
              "falseticker",
              "outlier",
              "reject",
              "backup",
              "pps",
              "excess"
            ]
          },
          "name": {
            "type": "string"
          },
          "refid": {
            "type": "string"
          },
          "stratum": {
            "type": "integer"
          },
          "when": {
            "type": "string"
          },
          "poll": {
            "type": "integer"
          },
          "reach": {
            "type": "integer",
            "description": "到達レジスタ（8進数 377 = 255）"
          },
          "offset_ms": {
            "type": "number"
          },
          "jitter_ms": {
            "type": "number"
          }
        }
      },
      "Satellite": {
        "type": "object",
        "properties": {
          "prn": {
            "type": "integer"
          },
          "system": {
            "type": "string",
            "examples": [
              "GPS",
              "QZSS",
              "GLONASS",
              "GALILEO"
            ]
          },
          "elev": {
            "type": "integer",
            "description": "仰角（度）"
          },
          "azim": {
            "type": "integer",
            "description": "方位角（度）"
          },
          "snr": {
            "type": "integer",
            "description": "dB-Hz"
          },
          "tracked": {
            "type": "boolean"
          },
          "snr_min": {
            "type": "integer",
            "description": "直近60回の最小"
          },
          "snr_max": {
            "type": "integer",
            "description": "直近60回の最大"
          }
        }
      },
      "Jamming": {
        "type": "object",
        "properties": {
          "band": {
            "type": "string"
          },
          "freq": {
            "type": "number",
            "description": "MHz"
          },
          "strength": {
            "type": "integer",
            "description": "単位不明。ふだんの値との差で見る"
          }
        }
      },
      "GNSS": {
        "type": "object",
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Init",
              "Sync",
              "Holdover",
              "Unsync",
              "Forcesync",
              "Disabled",
              null
            ]
          },
          "last_adjust": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "ppb": {
            "type": [
              "integer",
              "null"
            ]
          },
          "antenna": {
            "type": [
              "string",
              "null"
            ]
          },
          "positioning": {
            "type": [
              "string",
              "null"
            ]
          },
          "pdop": {
            "type": [
              "number",
              "null"
            ]
          },
          "hdop": {
            "type": [
              "number",
              "null"
            ]
          },
          "vdop": {
            "type": [
              "number",
              "null"
            ]
          },
          "tracking": {
            "type": [
              "integer",
              "null"
            ]
          },
          "visible": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_snr": {
            "type": [
              "integer",
              "null"
            ]
          },
          "spoofing": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "string",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "string",
              "null"
            ]
          },
          "altitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "transitions": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "satellites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Satellite"
            }
          },
          "jamming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Jamming"
            }
          }
        }
      },
      "Hardware": {
        "type": "object",
        "properties": {
          "psu": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              }
            }
          },
          "temps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "celsius": {
                  "type": "number"
                }
              }
            }
          },
          "oscillator": {
            "type": "string"
          },
          "fan": {
            "type": "string"
          },
          "rtc_battery": {
            "type": "string"
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "subsystem": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostname": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "serial": {
            "type": [
              "string",
              "null"
            ]
          },
          "boot_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "uptime": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipv4": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
